{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "ask",
			"rm *": "deny",
			"rm -rf *": "deny",
			"rmdir *": "deny",
			"del *": "deny",
			"Remove-Item *": "deny",
			"ri *": "deny",
			"docker compose down -v*": "deny",
			"docker volume rm *": "deny",
			"git push --force*": "deny",
			"git reset --hard*": "deny",
			"*.env*": "deny",
			"*.env.example*": "allow",
			"npm *": "allow",
			"npx tsc *": "allow",
			"git status": "allow",
			"git diff *": "allow"
		}
	}
}